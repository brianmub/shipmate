{
  "expo": {
    "name": "Shipmate",
    "slug": "shipmate",
    "scheme": "shipmate",
    "version": "2.1.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shipmate.shipmate",
      "buildNumber": "22",
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ],
        "NSLocationWhenInUseUsageDescription": "Shipmate requires access to your location to show available courier jobs, calculate delivery routes, and provide real-time package tracking.",
        "NSCameraUsageDescription": "Shipmate requires camera access to capture photo proof of delivery and photograph driver verification documents.",
        "NSPhotoLibraryUsageDescription": "Shipmate requires photo library access to upload driver licenses, vehicle documents, and delivery proof photos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.shipmate.shipmate",
      "versionCode": 35,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyC5wMs1-PtvFzF_Jozb14FJMwsrkLiQt3o"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "jsEngine": "hermes"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "ffd47272-3882-40d0-b2d3-9bbfb92e769b"
      }
    },
    "owner": "shipmate.co.zw",
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#055FEE"
        }
      ]
    ]
  }
}
